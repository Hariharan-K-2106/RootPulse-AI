# Optional local configuration
PORT=5000
FLASK_DEBUG=false
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
SESSION_SECRET_KEY=replace_with_a_random_secret
SESSION_COOKIE_SECURE=false

# Optional local model settings; weights download on the first supported crop analysis.
CROP_MODEL_REPO=BiernyVR/crop-disease-classifier
CROP_MODEL_REVISION=3b75000f61dbfaca85a28000544fe479d2561b6b
CROP_MODEL_MIN_SCORE=0.60
CROP_MODEL_MIN_MARGIN=0.08

# Illustrative irrigation advisory thresholds (not agronomic recommendations)
IRRIGATION_MOISTURE_LOW=30
IRRIGATION_MOISTURE_HIGH=70
IRRIGATION_SEEDLING_ADJUSTMENT=5
IRRIGATION_VEGETATIVE_ADJUSTMENT=0
IRRIGATION_FLOWERING_ADJUSTMENT=5
IRRIGATION_FRUITING_ADJUSTMENT=5
IRRIGATION_MATURITY_ADJUSTMENT=-5
RAIN_SMART_MIN_MM=5
RAIN_SMART_MIN_PROBABILITY=60
OPEN_METEO_TIMEOUT_SECONDS=6
